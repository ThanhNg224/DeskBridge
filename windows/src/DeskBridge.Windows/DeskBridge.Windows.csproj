<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>DeskBridge.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Product>DeskBridge</Product>
    <Company>DeskBridge</Company>
    <Description>Seamless desktop mouse and keyboard bridge for Android</Description>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DeskBridge.Core/DeskBridge.Core.csproj" />
    <InternalsVisibleTo Include="DeskBridge.Windows.Tests" />
  </ItemGroup>
</Project>
